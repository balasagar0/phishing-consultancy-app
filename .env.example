# Copy to .env and edit. A variable set in the real environment wins over this file.
MCPD_APP_NAME=Multi-Channel Phishing Detection
# Where the database, the master key and every client's event store live. Back this folder up; never put it in git.
MCPD_DATA_DIR=./data
# Port for start_app.bat / start.sh (8765 by default).
MCPD_PORT=8765
# Set to 1 when the app is served over HTTPS (it then sends cookies only over HTTPS).
MCPD_SECURE_COOKIES=0
MCPD_SESSION_HOURS=12
# The retention purge runs this often (hours); 0 turns it off.
MCPD_PURGE_INTERVAL_HOURS=24
# The secret every client's key is derived from (64 hex characters). Leave unset to create one in the data folder.
# If you set it, keep it in a secrets manager; losing it makes stored hashes unmatchable.
# MCPD_MASTER_KEY=
# PostgreSQL instead of SQLite (also pip install "psycopg[binary]"):
# MCPD_DATABASE_URL=postgresql+psycopg://user:password@db-host/mcpd
# Docker and Caddy only: the public name of the server, for its HTTPS certificate.
MCPD_DOMAIN=phishing.example.com
